[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "Rcppautodiff"]
	path = Rcppautodiff
	url = https://github.com/sn248/rcppautodiff
[submodule "r2sbml"]
	path = r2sbml
	url = https://github.com/sn248/r2sbml
[submodule "sundialr"]
	path = sundialr
	url = https://github.com/sn248/sundialr
